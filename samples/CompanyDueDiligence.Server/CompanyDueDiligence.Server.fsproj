<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- The browser demo hosted on this computer with a JSON API: every register, keys saved in Settings and bulk sources downloaded there. Listens on http://localhost:5190 only. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="KeyStore.fs" />
    <Compile Include="BulkService.fs" />
    <Compile Include="Available.fs" />
    <Compile Include="Api.fs" />
    <Compile Include="App.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="FSharp.Core" Version="10.1.401" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CompanyDueDiligence.Web\CompanyDueDiligence.Web.fsproj" />
    <ProjectReference Include="..\..\src\CompanyDueDiligence\CompanyDueDiligence.fsproj" />
  </ItemGroup>

</Project>
