    "UnauthorisedError" : {
      "title": "Unauthorised Error",
      "type" : "object",
      "properties" : {
        "timestamp" : {
          "type" : "string",
          "example" : "2022-04-05T11:41:09.568+00:00"
        },
        "status" : {
          "type" : "string",
          "example" : "401"
        },
        "error" : {
          "type" : "string",
          "example" : "Unauthorized"
        },
        "path" : {
          "type" : "string",
          "example" : "/psc-discrepancy-reports/f020183f-b487-41ac-83b6-5bc9ee97a150"
        }
      }
    }
  },
  "responses" : {
    "BadRequest" : {
      "description" : "The body has errors. The correct error is displayed if a single element is omitted from the call but if multiple elements are left out not all errors are displayed. Eg if only the status is added to the body of a /psc-discrepancy-reports POST the only error that fires is for the obliged-entity type and not the other 4 fields that are missing.",
      "schema" : {
        "$ref" : "#/definitions/Error"
      }
    },
    "NotFound" : {
      "description" : "Company cannot be found on the register",
      "schema" : {
        "$ref" : "#/definitions/Error"
      }
    },
    "NotAuthorised" : {
      "description" : "User is not authorised to update report",
      "schema" : {
        "$ref" : "#/definitions/UnauthorisedError"
      }
    }
  }
}
